baseURL: "https://hugo-profile.netlify.app"
languageCode: "en-us"
title: "Data-Driven Justice"
theme: hugo-profile

outputs:
  home:
    - "HTML"
    - "RSS"
    - "JSON"
  page:
    - "HTML"
    - "RSS"

Paginate: 3
enableRobotsTXT: true
# disqusShortname: your-disqus-shortname
# googleAnalytics: G-MEASUREMENT_ID

markup:
  goldmark:
    renderer:
      unsafe: true

Menus:
  main:
    - identifier: blog
      name: Blog
      title: Blog posts
      url: /post
      weight: 1
  #  - identifier: gallery
  #    name: Gallery
  #    title: Blog posts
  #    url: /gallery
  #    weight: 2
    #Dropdown menu
    # - identifier: dropdown
    #   title: Example dropdown menu
    #   name: Dropdown
    #   weight: 3
    # - identifier: dropdown1
    #   title: example dropdown 1
    #   name: example 1
    #   url: /#
    #   parent: dropdown
    #   weight: 1
    # - identifier: dropdown2
    #   title: example dropdown 2
    #   name: example 2
    #   url: /#
    #   parent: dropdown
    #   weight: 2

params:
  title: "Data-Driven Justice"
  description: Data-Driven Justice helps organizations leverage data and technology to better serve their communities through strategic consulting and custom development.
  # staticPath: ""  # The path to serve the static files from
  favicon: "/db_logo_transparent.png"

  # Whether to serve bootstrap css and js files from CDN or not. Can be set to true, "css" or "js" to choose between
  # serving both, only the css, or only the js files through the CDN. Any other value will make so that CDN is not used.
  # Note the lack of "" in true, it should be of boolean type.
  useBootstrapCDN: false

  # If you want to load dynamically responsive images from Cloudinary
  # This requires your images to be uploaded + hosted on Cloudinary
  # Uncomment and change YOUR_CLOUD_NAME to the Cloud Name in your Cloudinary console
  # cloudinary_cloud_name: "YOUR_CLOUD_NAME"
  
  # Whether to add mathjax support on all pages. Alternatively, you can opt-in per page by adding `mathjax: true` in the frontmatter.
  mathjax: false

  # Whether the fade animations on the home page will be enabled
  animate: true

  theme:
    disableThemeToggle: true
    defaultTheme: "light" # dark

  font:
    fontSize: 1rem # default: 1rem
    fontWeight: 400 # default: 400
    lineHeight: 1.5 # default: 1.5
    textAlign: left # default: left

  # color preference
  # color:
  #   textColor:
  #   secondaryTextColor:
  #   backgroundColor:
  #   secondaryBackgroundColor:
  #   primaryColor:
  #   secondaryColor:

  #   darkmode:
  #     textColor:
  #     secondaryTextColor:
  #     backgroundColor:
  #     secondaryBackgroundColor:
  #     primaryColor:
  #     secondaryColor:

  # If you want to customize the menu, you can change it here
  navbar:
    align: ms-auto # Left: ms-auto | center: mx-auto | right: me-auto | Default: ms-auto
    # brandLogo: "/logo.png" # Logo for the brand | default is the favicon variable
    # showBrandLogo: false # Show brand logo in nav bar | default is true
    brandName: "Data-Driven Justice" # Brand name for the brand | default is the title variable
    disableSearch: false
    # searchPlaceholder: "Search"
    stickyNavBar:
      enable : true
      showOnScrollUp : true
    menus:
      disableAbout: false
      disableExperience: false
      disableEducation: true
      disableProjects: true
      disableAchievements: true
      disableContact: false
      disableClientWork: false

  # Hero
  hero:
    enable: true
    intro: "We are"
    title: "Data-Driven Justice"
    subtitle: "transforming data into impact."
    content: "We help organizations leverage data and technology to better serve their communities through strategic consulting, custom software development, and data infrastructure solutions."
    image: /images/hero.svg
    bottomImage:
      enable: true
    # roundImage: true # Make hero image circular | default false
    button:
      enable: true
      name: "Our Services"
      url: "#about"
      download: false
      newPage: false
    socialLinks:
      fontAwesomeIcons:
        - icon: fab fa-github
          url: https://github.com/danbernstein
        - icon: fab fa-linkedin
          url: https://www.linkedin.com/in/danbernstein94/
      #customIcons:
      #  - icon: /fav.png
      #    url: "https://example.com"

  # About
  about:
    enable: true
    title: "About"
    image: "/images/me.jpg"
    content: |-
      Data-Driven Justice is a specialized consulting firm focused on helping nonprofits and small businesses transform their data into actionable insights and operational efficiency.

      We work with local and national organizations, grassroots initiatives, and government entities that struggle to bring together technology, people, and processes to make data a strategic resource for effectively delivering social services and solutions.

      Our team combines deep technical expertise with sector-specific knowledge to deliver solutions that truly meet your organization's needs. Have a challenge you want to discuss? Let's connect!
    skills:
      enable: true
      title: "Our Core Services:"
      items:
        - "Software Development"
        - "Web Scraping"
        - "Cloud Adoption (AWS, GCP, Azure)"
        - "Low-Code and No-Code Solutions"
        - "Process Mapping and Landscape Analysis"
      #  - "Data Landscape Analysis"
        - "Database Management and Optimization"
       # - "Data Migration"
        - "Data Analysis for Policy and Programs"
        - "Statistical Modeling"
        - "Machine Learning"
        - "Generative AI"

  # Experience
  experience:
    enable: true
    items:
      - job: "Software Development"
        company: "Custom Solutions for Your Organization"
        date: "Full-Stack Development"
        content: |
          We build custom software solutions tailored to your organization's unique needs, from web applications to data processing systems. Our development approach prioritizes user experience, scalability, and maintainability.

          Whether you need a client portal, internal management system, or data visualization dashboard, we work closely with your team to understand requirements and deliver solutions that truly serve your mission. We specialize in modern web technologies, API integration, and cloud-native architectures that grow with your organization.

      - job: "Web Scraping & Data Collection"
        company: "Automated Data Gathering"
        date: "Scalable Data Pipelines"
        content: |
          Transform manual data collection processes into automated, reliable systems. We design and implement web scraping solutions that gather data from websites, government portals, and public databases while respecting rate limits and data usage policies.

          Our scraping solutions include data validation, transformation pipelines, and scheduling systems to ensure you receive clean, structured data on a regular basis. We handle complex scenarios including JavaScript-heavy sites, authentication requirements, and CAPTCHA systems.

      - job: "Cloud Adoption & Infrastructure"
        company: "AWS, GCP, Azure Expertise"
        date: "Scalable Cloud Solutions"
        content: |
          Transform your organization's technology infrastructure with strategic cloud adoption. We help you migrate from legacy systems, optimize costs, and leverage cloud-native services for improved performance and reliability.

          Our cloud expertise spans database migration, serverless architectures, automated deployments, and security best practices. We provide hands-on implementation support and knowledge transfer to ensure your team can confidently manage and expand your cloud infrastructure.

      - job: "Data Analysis & Statistical Modeling"
        company: "Evidence-Based Decision Making"
        date: "Research & Analytics"
        content: |
          Turn your data into actionable insights through rigorous statistical analysis, machine learning models, and predictive analytics. We specialize in program evaluation, impact assessment, and policy analysis for social sector organizations.

          From identifying service gaps to measuring program outcomes, we help you understand what your data reveals about your community's needs and your organization's impact. Our analysis drives strategic decisions and supports grant applications with compelling evidence.

      - job: "Process Mapping & Automation"
        company: "Operational Efficiency"
        date: "Workflow Optimization"
        content: |
          Streamline your operations through comprehensive process mapping, bottleneck identification, and strategic automation. We work with your team to document current workflows, identify improvement opportunities, and implement solutions that save time and reduce errors.

          Our approach combines low-code/no-code solutions with custom development to create sustainable improvements. We help you leverage tools like Zapier, Microsoft Power Platform, and custom integrations to eliminate manual tasks and improve data quality.

      - job: "Database Management & Optimization"
        company: "Data Infrastructure Excellence"
        date: "Scalable Data Systems"
        content: |
          Build and optimize robust database systems that support your organization's growth and reporting needs. From database design and migration to performance optimization and backup strategies, we ensure your data is secure, accessible, and reliable.

          We work with various database technologies including PostgreSQL, MySQL, and cloud-based solutions. Our database solutions include automated reporting, data validation systems, and integration with your existing tools to create a unified data ecosystem.

      - job: "Machine Learning & AI Integration"
        company: "Intelligent Automation"
        date: "Advanced Analytics"
        content: |
          Leverage artificial intelligence and machine learning to automate complex tasks, identify patterns, and make predictions from your data. We implement practical AI solutions including document processing, text analysis, predictive modeling, and chatbot development.

          Our AI implementations are designed for real-world deployment with proper monitoring, bias detection, and explainability features. We help you understand when AI is appropriate for your use case and ensure solutions integrate seamlessly with your existing workflows.





